{
  "name": "forge614-shell",
  "version": "1.11.0",
  "private": true,
  "description": "A minimal Forge614 terminal workspace powered by Pi",
  "type": "module",
  "bin": { "forge614-shell": "dist/cli.js" },
  "files": ["dist", "extensions"],
  "engines": { "node": ">=22.19.0", "bun": ">=1.3.9" },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build src/cli.ts --target=node --packages=external --outdir=dist",
    "bundle:release": "bun scripts/release-bundle.mjs",
    "dev": "bun run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "prepack": "bun run build"
  },
  "pi": { "extensions": ["./extensions/forge614-shell.ts"] },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
